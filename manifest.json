{
  "manifest_version": 3,
  "name": "GTA 6 Spoiler Blocker",
  "version": "1.5.0",
  "description": "Hides GTA 6 posts on X (Twitter) and YouTube so you can stay spoiler-free.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "GTA 6 Spoiler Blocker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://www.youtube.com/*"
      ],
      "js": ["src/matcher.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ]
}
